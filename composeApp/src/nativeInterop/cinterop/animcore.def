# Kotlin/Native cinterop for the core C ABIs (panel_core_c.h + controller_core_c.h).
# Generates the `animcore.*` bindings used by iosMain/NativeAnimCore.ios.kt and NativeSceneCore.ios.kt.
# Include dirs are supplied from build.gradle.kts (resolved firmware path).
package = animcore
language = C
headers = panel_core_c.h controller_core_c.h
headerFilter = panel_core_c.h controller_core_c.h
