# Kotlin/Native cinterop for the animation core C ABI (anim_core_c.h).
# Generates the `animcore.*` bindings used by iosMain/NativeAnimCore.ios.kt.
# Include dirs are supplied from build.gradle.kts (resolved firmware path).
package = animcore
language = C
headers = anim_core_c.h
headerFilter = anim_core_c.h
